# Database (Aiven MySQL)
DB_HOST=your_aiven_host
DB_PORT=your_aiven_port
DB_USER=your_aiven_user
DB_PASSWORD=your_aiven_password
DB_NAME=your_database_name
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_PROFILE_FOLDER=CTA Files/Profiles
CLOUDINARY_EXTERNAL_PARTNER_LOGO_FOLDER=HTA Files/External Partners Logo

# Google OAuth (redirect URI must be this backend's /api/gdrive/oauth/callback URL)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-backend.onrender.com/api/gdrive/oauth/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_PATH=CTA Files/Documents

# Email (Gmail app password for OTP)
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASS=your_gmail_app_password

# Server
PORT=3000
ALLOWED_ORIGINS=https://your-electron-app-origin
