{
  "name": "smart-academic-system-ccs",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:current": "electron-builder --win nsis",
    "dist:alpha1": "electron-builder --win nsis -c.extraMetadata.version=1.0.0-alpha.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.4.1",
    "googleapis": "^171.4.0",
    "mysql2": "^3.5.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.smartacademic.ccs",
    "productName": "Smart Academic System CCS",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "services/**/*",
      "database/**/*",
      "assets/**/*",
      "package.json",
      ".env.example"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Academic CCS"
    }
  }
}
